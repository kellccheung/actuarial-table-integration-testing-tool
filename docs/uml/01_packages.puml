@startuml prophet_table_tool_packages
title Prophet Table Change Tool — Package / Component Overview
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam shadowing false

package "prophet_table_tool" {
  [__main__\nmain()] as CLI

  package "Stage 1" {
    [changelog\ngenerate_change_log()] as GCL
    [changelog_review\nper-folder review xlsx] as REV
  }

  package "Stage 2" {
    [integrate\nintegrate_changes()] as INT
  }

  package "Supporting modules" {
    [control\nControlConfig, read_control] as CTRL
    [prophet_csv\nProphetTable I/O] as CSV
    [diff\ndiff_table, detect_conflicts] as DIFF
    [audit\nsetup_audit_logger] as AUDIT
    [utils\nhash, run_id, paths] as UTILS
  }
}

package "External I/O" {
  database "Control.xlsx" as CTRLX
  folder "ChangeRequests/**/before|after\n*.csv / *.FAC" as BA
  folder "Production_Tables/**\n*.csv / *.FAC" as PROD
  file "Output/ChangeLog_*.xlsx" as CLOG
  file "Output/ChangeLog_*_Detail.csv" as DETAIL
  folder "Output/ChangeLog_*_reviews/" as REVOUT
  file "Output/IntegrationReport_*.xlsx" as RPT
  folder "Output/New_Production_Tables/" as NEW
  folder "Output/Audit/*.log" as LOGS
}

CLI --> GCL
CLI --> INT
CLI --> CTRL

GCL --> CTRL
GCL --> CSV
GCL --> DIFF
GCL --> REV
GCL --> AUDIT
GCL --> UTILS

INT --> CTRL
INT --> CSV
INT --> DIFF
INT --> AUDIT
INT --> UTILS

GCL --> CTRLX
GCL --> BA
GCL --> CLOG
GCL --> DETAIL
GCL --> REVOUT
GCL --> LOGS

INT --> CTRLX
INT --> CLOG
INT --> DETAIL
INT --> PROD
INT --> RPT
INT --> NEW
INT --> LOGS

@enduml
