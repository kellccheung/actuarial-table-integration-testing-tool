@startuml prophet_table_tool_stage1_sequence
title Stage 1 -- generate_change_log
skinparam shadowing false
autonumber

actor User
participant "__main__" as CLI
participant "read_control" as CTRL
participant "generate_change_log" as GCL
participant "audit" as AUDIT
participant "prophet_csv" as CSV
participant "diff_table" as DIFF
participant "detect_conflicts" as CONF
participant "changelog_review" as REV
database "ChangeLog_*_Detail.csv" as DETAIL
participant "ChangeLog_*_reviews" as REVOUT
database "ChangeLog_*.xlsx" as XLSX

User -> CLI : mode = generate_changelog
CLI -> CTRL : read_control(control_path)
CTRL --> CLI : ControlConfig
CLI -> GCL : generate_change_log(control_path, control)

GCL -> AUDIT : setup_audit_logger(output, run_id, mode)

loop each included ChangeRequest (sorted by order)
  GCL -> CSV : discover_csv_tables(before/)\nrecursive csv or FAC
  GCL -> CSV : discover_csv_tables(after/)

  alt empty CR folder (no CSVs)
    GCL -> AUDIT : warning, Summary status = EMPTY
  else table only in before/
    GCL -> AUDIT : warning + skip\n(no change rows)
  else table in both, or only in after/
    GCL -> CSV : read_prophet_csv(before?)\nencoding logged
    GCL -> CSV : read_prophet_csv(after?)
    GCL -> DIFF : diff_table(cr_id, table,\nbefore, after, control)
    DIFF --> GCL : DiffResult\n(structural_rows + cell_changes)
    GCL -> REV : add_contribution(before, after, diff)
  end
end

GCL -> CONF : detect_conflicts(structural_rows, cell_changes)
CONF --> GCL : Conflicts list

GCL -> DETAIL : write ChangeLog_*_Detail.csv
GCL -> REV : write_review_workbook per folder group
REV --> REVOUT : Conflicts + one sheet per table
GCL -> XLSX : write Summary / Conflicts / ReviewFiles
GCL -> AUDIT : control / Change Log hashes\nfinal_status = SUCCESS
GCL --> CLI : Path to ChangeLog_*.xlsx
CLI --> User : Change Log path

@enduml
