@startuml prophet_table_tool_stage2_sequence
title Stage 2 -- integrate_changes
skinparam shadowing false
autonumber

actor User
participant "__main__" as CLI
participant "read_control" as CTRL
participant "integrate_changes" as INT
database "ChangeLog_*.xlsx" as CLOG
database "ChangeLog_*_Detail.csv" as DETAIL
participant "prophet_csv" as CSV
participant "_validate_table_changes" as VAL
participant "_apply_table_changes" as APP
participant "New_Production_Tables" as OUT
database "IntegrationReport_*.xlsx" as RPT

User -> CLI : mode = validate_only or apply
CLI -> CTRL : read_control(control_path)
CTRL --> CLI : ControlConfig
CLI -> CLI : resolve Change Log\n(explicit path, Output filename,\nor newest ChangeLog_*.xlsx)
CLI -> INT : integrate_changes(control,\nchange_log, mode, control)

INT -> CLOG : load Conflicts sheet
INT -> DETAIL : load Detail.csv\n(fallback: ChangeLog_Detail sheet)
note right of INT
  Filter: include=Y AND approved=Y
  Sort by Control.order
end note

alt unresolved conflicts AND mode = apply
  INT -> RPT : Validation_Report FAIL
  INT --> CLI : report path (hard stop)
else continue
  INT -> CSV : discover production (recursive)\nread touched tables only
  CSV --> INT : Dict of ProphetTable

  loop each approved CR in Control.order
    loop tables for this CR
      INT -> VAL : validate vs current\nin-memory table
      VAL --> INT : ok / failure messages
    end
    alt this CR failed validation
      INT -> INT : skip in-memory apply
    else CR ok
      INT -> APP : apply change rows in memory
      APP --> INT : updated ProphetTable\n(later CRs see this)
    end
  end

  alt any CR failed
    INT -> RPT : FAIL\n(never write tables)
    INT --> CLI : report path
  else mode = validate_only
    INT -> RPT : DRY_RUN_SUCCESS\n(zero table writes)
    INT --> CLI : report path
  else mode = apply
    INT -> OUT : write changed tables\n(!N / star + dummy lines,\noriginal relative paths)
    INT -> OUT : copy unchanged\nproduction tables
    INT -> RPT : SUCCESS
    INT --> CLI : report path
  end
end

CLI --> User : Integration Report path

@enduml
